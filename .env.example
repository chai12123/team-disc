# ==== TeamFit environment ====
# คัดลอกเป็น .env.local แล้วเติมค่า (ห้าม commit .env.local)

# --- ฐานข้อมูล (จำเป็น) ---
# Supabase: Dashboard → Project Settings → Database → Connection string → URI
#   แนะนำใช้ "Transaction pooler" (port 6543) สำหรับ Vercel/serverless และเติม ?sslmode=require
#   ตัวอย่าง: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Postgres ท้องถิ่น: postgresql://postgres:postgres@127.0.0.1:5432/teamfit
DATABASE_URL=

# --- Supabase Auth (ฝั่งองค์กร) ---
# Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Dashboard → Project Settings → API → Project API keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ถ้าเว้นว่างทั้งสองค่า และ AUTH_MODE=dev แอปจะใช้ dev login (เฉพาะ non-production)

# dev = ใช้บัญชีทดลองในเครื่องโดยไม่ต้องมี Supabase Auth, supabase = ใช้ Supabase Auth
AUTH_MODE=dev
# secret สำหรับเซ็น cookie ของ dev login และ hash IP ใน consent (สุ่มด้วย: openssl rand -hex 32)
APP_SECRET=change-me-to-a-random-64-hex-string

# --- Anthropic (AI role discovery + คำอธิบายรายงาน) ---
# Console → https://platform.claude.com → API Keys → Create Key
# เว้นว่าง = Demo mode (scripted adapter ไม่ใช่ AI จริง และหน้าจอจะติดป้าย Demo ชัดเจน)
ANTHROPIC_API_KEY=
# ชื่อ model ตั้งผ่าน env เพื่อเปลี่ยนรุ่นได้โดยไม่แก้โค้ด (ดูรายชื่อปัจจุบันที่ platform.claude.com/docs)
ANTHROPIC_MODEL=claude-opus-5-5
# claude | demo  (ถ้าไม่ตั้งค่า: มี key = claude, ไม่มี key = demo)
AI_PROVIDER=
# timeout ต่อการเรียก AI หนึ่งครั้ง (มิลลิวินาที)
AI_TIMEOUT_MS=60000

# --- แอป ---
# URL ฐานที่ใช้สร้างลิงก์ผู้สมัคร (เช่น https://teamfit.vercel.app) ถ้าเว้นว่างจะใช้ origin ของ request
NEXT_PUBLIC_APP_URL=
